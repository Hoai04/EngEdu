<%- include('../partials/account-start', { active: 'thong-tin' }) %>
<% const e = (n) => errors[n]; %>
<h2>Thông tin cá nhân</h2>
<form class="card mt" method="post" action="/tai-khoan" novalidate>
  <div class="form-grid">
    <div class="field <%= e('ho_ten') ? 'has-error' : '' %>"><label for="ho_ten">Họ và tên</label><input class="input" id="ho_ten" name="ho_ten" value="<%= v.ho_ten %>">
      <% if (e('ho_ten')) { %><div class="error-text"><%= e('ho_ten') %></div><% } %></div>
    <div class="field"><label>Email</label><input class="input" value="<%= v.email %>" disabled></div>
    <div class="field <%= e('sdt') ? 'has-error' : '' %>"><label for="sdt">Số điện thoại</label><input class="input" id="sdt" name="sdt" value="<%= v.sdt || '' %>">
      <% if (e('sdt')) { %><div class="error-text"><%= e('sdt') %></div><% } %></div>
    <div class="field <%= e('ngay_sinh') ? 'has-error' : '' %>"><label for="ngay_sinh">Ngày sinh</label><input class="input" id="ngay_sinh" name="ngay_sinh" type="date" value="<%= h.isoDate(v.ngay_sinh) || v.ngay_sinh || '' %>">
      <% if (e('ngay_sinh')) { %><div class="error-text"><%= e('ngay_sinh') %></div><% } %></div>
    <div class="field"><label for="gioi_tinh">Giới tính</label><select class="input" id="gioi_tinh" name="gioi_tinh"><option value="">Chưa chọn</option>
      <% Object.entries(h.LABELS.gioiTinh).forEach(([k, l]) => { %><option value="<%= k %>" <%= v.gioi_tinh === k ? 'selected' : '' %>><%= l %></option><% }) %></select></div>
    <div class="field"><label for="trinh_do">Trình độ tiếng Anh</label><select class="input" id="trinh_do" name="trinh_do"><option value="">Chưa chọn</option>
      <% h.TRINH_DO.forEach(t => { %><option <%= v.trinh_do === t ? 'selected' : '' %>><%= t %></option><% }) %></select></div>
    <div class="field"><label for="nghe_nghiep">Nghề nghiệp</label><input class="input" id="nghe_nghiep" name="nghe_nghiep" value="<%= v.nghe_nghiep || '' %>"></div>
    <div class="field"><label for="noi_hoc_lam">Trường học / Nơi làm việc</label><input class="input" id="noi_hoc_lam" name="noi_hoc_lam" value="<%= v.noi_hoc_lam || '' %>"></div>
    <div class="field full"><label for="dia_chi">Địa chỉ</label><input class="input" id="dia_chi" name="dia_chi" value="<%= v.dia_chi || '' %>">
      <div class="small muted">Giáo viên không xem được địa chỉ của bạn.</div></div>
    <div class="field full"><label for="muc_tieu">Mục tiêu học tiếng Anh</label><input class="input" id="muc_tieu" name="muc_tieu" value="<%= v.muc_tieu || '' %>"></div>
  </div>
  <div class="row between"><button class="btn">Lưu thông tin</button><span class="small muted">Thành viên từ <%= h.date(v.ngay_tao) %></span></div>
</form>
<%- include('../partials/account-end') %>
