<%- include('../partials/staff-start') %>
<div class="row between mb">
  <div class="chips">
    <% [['cho-duyet', 'Chờ duyệt'], ['hien-thi', 'Đang hiển thị'], ['bi-an', 'Bị ẩn']].forEach(([k, l]) => { %>
      <a class="chip <%= tab === k ? 'active' : '' %>" href="?tab=<%= k %>"><%= l %></a>
    <% }) %>
  </div>
  <form method="get"><input type="hidden" name="tab" value="<%= tab %>">
    <select class="input" name="sao" onchange="this.form.submit()" style="width:auto">
      <option value="">Tất cả số sao</option><% [5, 4, 3, 2, 1].forEach(s => { %><option value="<%= s %>" <%= sao === s ? 'selected' : '' %>><%= s %> sao</option><% }) %>
    </select></form>
</div>
<form id="bulk" method="post" action="/admin/danh-gia/duyet-nhieu"></form>
<div class="card card-flush table-wrap">
  <table class="table">
    <thead><tr><% if (tab === 'cho-duyet') { %><th><input type="checkbox" onclick="document.querySelectorAll('.pick').forEach(c => c.checked = this.checked)" aria-label="Chọn tất cả"></th><% } %>
      <th>Học viên / Khóa học</th><th>Đánh giá</th><th>Xử lý</th></tr></thead>
    <tbody>
      <% items.forEach(r => { %>
        <tr>
          <% if (tab === 'cho-duyet') { %><td><input class="pick" type="checkbox" name="ids" value="<%= r.id %>" form="bulk" aria-label="Chọn"></td><% } %>
          <td><b><%= r.ho_ten %></b><div class="small muted"><%= r.khoa_hoc_ten %> · GV <%= r.giao_vien_ten || '–' %><br><%= h.datetime(r.ngay_tao) %></div></td>
          <td style="max-width:420px"><span class="rating"><%= h.stars(r.so_sao) %></span><div><%= r.noi_dung || '' %></div>
            <% if (r.phan_hoi_gv) { %><div class="reply small"><b>GV:</b> <%= r.phan_hoi_gv %></div><% } %>
            <% if (r.ly_do_an) { %><div class="small muted">Lý do ẩn: <%= r.ly_do_an %></div><% } %></td>
          <td><div class="actions">
            <% if (r.trang_thai === 'CHO_DUYET') { %><form method="post" action="/admin/danh-gia/<%= r.id %>/duyet"><button class="btn btn-sm">Duyệt</button></form><% } %>
            <% if (r.trang_thai === 'BI_AN') { %><form method="post" action="/admin/danh-gia/<%= r.id %>/hien"><button class="btn btn-sm">Hiển thị lại</button></form><% } %>
            <form method="post" action="/admin/danh-gia/<%= r.id %>/xoa" onsubmit="return confirm('Xóa vĩnh viễn đánh giá này?')"><button class="btn btn-sm btn-outline">Xóa</button></form>
          </div>
          <% if (r.trang_thai !== 'BI_AN') { %>
            <details class="small mt"><summary class="btn-link">Ẩn đánh giá</summary>
              <form class="cell-form mt" method="post" action="/admin/danh-gia/<%= r.id %>/an"><input class="input" name="ly_do" placeholder="Lý do ẩn" value="Vi phạm quy định nội dung"><button class="btn btn-sm btn-outline">Ẩn</button></form></details>
          <% } %></td>
        </tr>
      <% }) %>
    </tbody>
  </table>
  <% if (!items.length) { %><div class="empty">Không có đánh giá.</div><% } %>
</div>
<% if (tab === 'cho-duyet' && items.length) { %><button class="btn mt" form="bulk">Duyệt các mục đã chọn</button><% } %>
<%- include('../partials/staff-end') %>
