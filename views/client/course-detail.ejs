<%- include('../partials/client-start') %>
<% const seatsLeft = Math.max(0, Number(course.so_cho_toi_da) - Number(course.cho_da_dung)); %>
<div class="page-head dark">
  <div class="container">
    <div class="crumb"><a href="/" style="color:inherit">Trang chủ</a> › <a href="/khoa-hoc?danh_muc=<%= course.danh_muc %>" style="color:inherit"><%= h.label('danhMuc', course.danh_muc) %></a> › <%= course.ten %></div>
    <h1><%= course.ten %></h1>
    <p class="muted" style="max-width:720px"><%= (course.mo_ta || '').split('\n')[0] %></p>
    <p class="small">
      <% if (course.diem_tb) { %><span style="color:#9DB9D6"><%= h.stars(course.diem_tb) %></span> <b><%= course.diem_tb %></b> (<%= course.so_danh_gia %> đánh giá) · <% } %>
      Giáo viên: <b><%= course.giao_vien_ten || 'Chưa phân công' %></b> · Trình độ: <b><%= course.trinh_do || '–' %></b> · Khai giảng: <b><%= h.date(course.ngay_khai_giang) || 'Liên hệ' %></b>
    </p>
  </div>
</div>
<div class="container section detail-layout">
  <div>
    <nav class="tabs">
      <a href="?tab=tong-quan" class="<%= tab === 'tong-quan' ? 'active' : '' %>">Tổng quan</a>
      <a href="?tab=noi-dung" class="<%= tab === 'noi-dung' ? 'active' : '' %>">Nội dung (<%= lessons.length %> bài)</a>
      <a href="?tab=giao-vien" class="<%= tab === 'giao-vien' ? 'active' : '' %>">Giáo viên</a>
      <a href="?tab=danh-gia" class="<%= tab === 'danh-gia' ? 'active' : '' %>">Đánh giá (<%= reviews.length %>)</a>
    </nav>

    <% if (tab === 'tong-quan') { %>
      <div class="card">
        <h3>Thông tin khóa học</h3>
        <dl class="info">
          <dt>Danh mục</dt><dd><%= h.label('danhMuc', course.danh_muc) %></dd>
          <dt>Trình độ</dt><dd><%= course.trinh_do || '–' %></dd>
          <dt>Lịch học</dt><dd><%= course.lich_hoc || '–' %></dd>
          <dt>Thời lượng</dt><dd><%= course.thoi_luong || '–' %></dd>
          <dt>Ngày khai giảng</dt><dd><%= h.date(course.ngay_khai_giang) || '–' %></dd>
          <dt>Sĩ số tối đa</dt><dd><%= course.so_cho_toi_da %> học viên</dd>
          <dt>Học phí</dt><dd><b><%= h.money(course.gia) %></b></dd>
        </dl>
        <% if (course.mo_ta) { %><h3 class="mt-lg">Mô tả</h3><p style="white-space:pre-line"><%= course.mo_ta %></p><% } %>
      </div>
    <% } else if (tab === 'noi-dung') { %>
      <div class="card card-flush lesson-list">
        <% if (!lessons.length) { %><div class="empty">Khóa học chưa có bài giảng.</div><% } %>
        <% let chap = null; lessons.forEach((l, i) => { if (l.chuong !== chap) { chap = l.chuong; %><div class="chapter"><%= chap || 'Bài giảng' %></div><% } %>
          <div class="lesson"><span><%= i + 1 %>. <%= l.tieu_de %></span><span class="muted small">🔒 Dành cho học viên</span></div>
        <% }) %>
      </div>
    <% } else if (tab === 'giao-vien') { %>
      <div class="card">
        <% if (!teacher) { %><p class="muted">Khóa học chưa được phân công giáo viên.</p><% } else { %>
          <div class="row"><span class="avatar avatar-lg"><%= h.initials(teacher.ho_ten) %></span>
            <div><h3 style="margin:0"><a href="/giao-vien/<%= teacher.id %>"><%= teacher.ho_ten %></a></h3><div class="muted"><%= teacher.chuyen_mon || '' %></div></div></div>
          <dl class="info mt">
            <dt>Học vị</dt><dd><%= teacher.hoc_vi || '–' %></dd>
            <dt>Chứng chỉ</dt><dd><%= teacher.chung_chi || '–' %></dd>
            <dt>Kinh nghiệm</dt><dd><%= teacher.kinh_nghiem_nam %> năm</dd>
          </dl>
          <% if (teacher.gioi_thieu) { %><p class="mt" style="white-space:pre-line"><%= teacher.gioi_thieu %></p><% } %>
        <% } %>
      </div>
    <% } else { %>
      <div class="card">
        <div class="row" style="align-items:flex-start;gap:32px">
          <div style="text-align:center"><div style="font-size:40px;font-weight:700"><%= course.diem_tb || '–' %></div>
            <div class="rating"><%= h.stars(course.diem_tb) %></div><div class="small muted"><%= reviews.length %> đánh giá</div></div>
          <div style="flex:1;min-width:220px">
            <% const max = Math.max(1, ...distribution.map(d => d.n)); distribution.forEach(d => { %>
              <div class="dist"><span><%= d.sao %>★</span><span class="bar"><i style="width:<%= Math.round(100 * d.n / max) %>%"></i></span><span><%= d.n %></span></div>
            <% }) %>
          </div>
        </div>
        <% if (!reviews.length) { %><p class="muted mt">Chưa có đánh giá nào.</p><% } %>
        <% reviews.forEach(r => { %>
          <div class="review">
            <div class="row between"><div class="row" style="gap:10px"><span class="avatar"><%= h.initials(r.ho_ten) %></span><div><b><%= r.ho_ten %></b><div class="rating small"><%= h.stars(r.so_sao) %></div></div></div>
              <span class="small muted"><%= h.date(r.ngay_tao) %></span></div>
            <% if (r.noi_dung) { %><p class="mt" style="margin-bottom:0"><%= r.noi_dung %></p><% } %>
            <% if (r.phan_hoi_gv) { %><div class="reply small"><b>Giáo viên phản hồi:</b> <%= r.phan_hoi_gv %></div><% } %>
          </div>
        <% }) %>
      </div>
    <% } %>
  </div>

  <aside class="card sticky">
    <div class="course-cover" style="margin:-20px -20px 16px;border-radius:10px 10px 0 0"><b><%= h.label('danhMuc', course.danh_muc) %></b><small><%= course.trinh_do || '' %></small></div>
    <div class="price" style="font-size:26px"><%= h.money(course.gia) %></div>
    <dl class="info small mt">
      <dt>Khai giảng</dt><dd><%= h.date(course.ngay_khai_giang) || '–' %></dd>
      <dt>Lịch học</dt><dd><%= course.lich_hoc || '–' %></dd>
      <dt>Thời lượng</dt><dd><%= course.thoi_luong || '–' %></dd>
      <dt>Chỗ còn lại</dt><dd><%= seatsLeft %> / <%= course.so_cho_toi_da %></dd>
    </dl>
    <div class="mt">
      <% if (status.kind === 'active') { %>
        <a class="btn btn-block" href="/hoc/<%= course.id %>">Vào học</a>
        <a class="btn btn-outline btn-block mt" href="/hoc/<%= course.id %>/danh-gia">Đánh giá khóa học</a>
      <% } else if (status.kind === 'pending') { %>
        <a class="btn btn-block" href="/thanh-toan/<%= status.tt.ma_don %>">Xem thanh toán</a>
        <p class="small muted mt">Đơn <%= status.tt.ma_don %> – <%= h.label('thanhToan', status.tt.trang_thai) %></p>
      <% } else if (status.kind === 'full') { %>
        <button class="btn btn-block" disabled>Đã đủ học viên</button>
        <a class="btn btn-outline btn-block mt" href="/tu-van?khoa_hoc=<%= course.id %>">Đăng ký tư vấn lớp sau</a>
      <% } else if (status.kind === 'staff') { %>
        <p class="small muted">Bạn đang đăng nhập với vai trò <%= currentUser.vai_tro === 'ADMIN' ? 'Admin' : 'Giáo viên' %>. Chỉ học viên mới đăng ký khóa học.</p>
      <% } else { %>
        <% if (status.kind === 'rejected') { %><p class="small" style="color:var(--error)">Đăng ký trước đã bị từ chối: <%= status.dk.ly_do_tu_choi %></p><% } %>
        <a class="btn btn-block" href="/dang-ky-hoc/<%= course.id %>"><%= status.kind === 'rejected' ? 'Đăng ký lại' : 'Đăng ký học' %></a>
        <a class="btn btn-outline btn-block mt" href="/tu-van?khoa_hoc=<%= course.id %>">Nhận tư vấn</a>
      <% } %>
    </div>
  </aside>
</div>
<%- include('../partials/client-end') %>
