<%- include('../partials/client-start') %>
<% const e = (n) => errors[n]; %>
<section class="section" style="background:var(--muted)"><div class="container" style="max-width:440px">
  <form class="card" method="post" action="/dat-lai-mat-khau/<%= token %>" novalidate>
    <h2>Đặt lại mật khẩu</h2>
    <p class="small muted">Tài khoản: <b><%= email %></b>. Liên kết này chỉ dùng được một lần và hết hạn sau 15 phút.</p>
    <div class="field <%= e('mat_khau_moi') ? 'has-error' : '' %>"><label for="mat_khau_moi">Mật khẩu mới (tối thiểu 8 ký tự)</label>
      <input class="input" id="mat_khau_moi" name="mat_khau_moi" type="password" minlength="8" required autofocus>
      <% if (e('mat_khau_moi')) { %><div class="error-text"><%= e('mat_khau_moi') %></div><% } %></div>
    <div class="field <%= e('nhap_lai') ? 'has-error' : '' %>"><label for="nhap_lai">Nhập lại mật khẩu mới</label>
      <input class="input" id="nhap_lai" name="nhap_lai" type="password" required>
      <% if (e('nhap_lai')) { %><div class="error-text"><%= e('nhap_lai') %></div><% } %></div>
    <button class="btn btn-block">Lưu mật khẩu mới</button>
  </form>
</div></section>
<%- include('../partials/client-end') %>
