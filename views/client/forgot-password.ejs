<%- include('../partials/client-start') %>
<section class="section" style="background:var(--muted)"><div class="container" style="max-width:440px">
  <form class="card" method="post" action="/quen-mat-khau" novalidate>
    <h2>Quên mật khẩu</h2>
    <p class="small muted">Nhập email và số điện thoại bạn đã dùng khi đăng ký. Nếu khớp, bạn sẽ được đặt mật khẩu mới ngay.</p>
    <% if (error) { %><div class="flash flash-error"><%= error %></div><% } %>
    <div class="field"><label for="email">Email</label><input class="input" id="email" name="email" type="email" value="<%= v.email || '' %>" required autofocus></div>
    <div class="field"><label for="sdt">Số điện thoại đã đăng ký</label><input class="input" id="sdt" name="sdt" type="tel" value="<%= v.sdt || '' %>" placeholder="0912345678" required></div>
    <button class="btn btn-block">Tiếp tục</button>
    <p class="small muted mt">Nhớ ra mật khẩu? <a href="/dang-nhap">Đăng nhập</a></p>
    <p class="small muted">Giáo viên chưa có số điện thoại trong hồ sơ, vui lòng liên hệ Admin để được đặt lại mật khẩu.</p>
  </form>
</div></section>
<%- include('../partials/client-end') %>
