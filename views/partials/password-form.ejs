<% const e = (n) => errors[n]; %>
<form class="card" method="post" style="max-width:460px" novalidate>
  <% [['mat_khau_cu', 'Mật khẩu hiện tại'], ['mat_khau_moi', 'Mật khẩu mới (tối thiểu 8 ký tự)'], ['nhap_lai', 'Nhập lại mật khẩu mới']].forEach(([n, l]) => { %>
    <div class="field <%= e(n) ? 'has-error' : '' %>"><label for="<%= n %>"><%= l %></label><input class="input" id="<%= n %>" name="<%= n %>" type="password" required>
      <% if (e(n)) { %><div class="error-text"><%= e(n) %></div><% } %></div>
  <% }) %>
  <button class="btn">Đổi mật khẩu</button>
</form>
